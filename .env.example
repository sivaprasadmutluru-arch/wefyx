DATABASE_PASSWORD=replace-with-a-strong-database-password
ADMIN_EMAIL=admin@wefyx.pro
ADMIN_PASSWORD=replace-with-a-strong-admin-password
JWT_SECRET=replace-with-at-least-32-random-characters
PUBLIC_URL=https://support.example.com
WEB_PORT=80
SEED_DATA=true

# Email SMTP
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=replace-with-gmail-app-password
MAIL_FROM=noreply@example.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# Card checkout: matching Stripe keys; only the publishable key goes to the browser.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Production SMS verification
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
