PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/wefyx
DATABASE_USERNAME=wefyx
DATABASE_PASSWORD=replace-with-strong-database-password
JPA_DDL_AUTO=update
CORS_ORIGINS=https://support.example.com
ADMIN_EMAIL=admin@wefyx.pro
ADMIN_PASSWORD=admin123
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION_SECONDS=28800
SEED_DATA=false

# Email SMTP
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=replace-with-gmail-app-password
MAIL_FROM=noreply@example.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# SMS OTP (Twilio Verify, six-digit service; India and UAE)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Client-demo environments may temporarily set this to true.
# It affects registration verification only, never password reset.
OTP_DEMO_BYPASS=false
