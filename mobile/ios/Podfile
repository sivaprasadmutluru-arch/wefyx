# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'WefyxSupportMobile' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Keep the app target from depending on AsyncStorage's generated build
    # products path during Swift compilation. Xcode can compile AppDelegate.swift
    # before that copied modulemap exists during archive, while this pod support
    # modulemap is available immediately after `pod install`.
    async_storage_modulemap = '${PODS_ROOT}/Target Support Files/AsyncStorage/AsyncStorage.modulemap'
    generated_async_storage_modulemap = '${PODS_CONFIGURATION_BUILD_DIR}/AsyncStorage/AsyncStorage.modulemap'

    Dir.glob("#{Pod::Config.instance.installation_root}/Pods/Target Support Files/Pods-WefyxSupportMobile/Pods-WefyxSupportMobile.*.xcconfig").each do |xcconfig_path|
      contents = File.read(xcconfig_path)
      updated_contents = contents.gsub(generated_async_storage_modulemap, async_storage_modulemap)
      File.write(xcconfig_path, updated_contents) if contents != updated_contents
    end
  end
end
